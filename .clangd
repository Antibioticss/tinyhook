CompileFlags:
  Add:
    - -I../include
    - -I../../include
    - -O3
    - -xc
    - -Wall
    - -Wshadow
  Compiler: clang

Diagnostics:
  ClangTidy:
    Add: [bugprone-*, cert-*, modernize-*, performance-*]
    Remove: [bugprone-easily-swappable-parameters]
    FastCheckFilter: None
    CheckOptions:
      bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: true

Completion:
  HeaderInsertion: Never
